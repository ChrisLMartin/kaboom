@page
@model Kaboom.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="card">
    <h2>Something went wrong</h2>
    <p>The app hit an unexpected error while processing your request.</p>
    @if (!string.IsNullOrWhiteSpace(Model.RequestId))
    {
        <p>Request ID: <code>@Model.RequestId</code></p>
    }
</section>
