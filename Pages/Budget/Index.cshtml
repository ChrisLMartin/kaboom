@page
@model Spendwise.Pages.Budget.IndexModel
@{
    ViewData["Title"] = "Budget";
    var startMonth = BudgetCalculator.ParseMonthKey(Model.StartMonthKey);
    var previousMonthKey = BudgetCalculator.ToMonthKey(startMonth.AddMonths(-1));
    var nextMonthKey = BudgetCalculator.ToMonthKey(startMonth.AddMonths(1));
    var months = Model.VisibleMonths.ToList();
}

<section class="budget-shell">
    <section class="budget-ribbon card">
        <div class="month-switcher">
            <a class="month-arrow" asp-page="/Budget/Index" asp-route-month="@previousMonthKey">‹</a>
            <div class="month-switcher-center">
                <p class="eyebrow">Budget allocations across multiple months</p>
                <div class="month-tabs">
                    @foreach (var month in months)
                    {
                        <a class="month-tab @(month.MonthKey == Model.StartMonthKey ? "active" : string.Empty)"
                           asp-page="/Budget/Index"
                           asp-route-month="@month.MonthKey">
                            @month.MonthDate.ToString("MMM")
                        </a>
                    }
                </div>
            </div>
            <a class="month-arrow" asp-page="/Budget/Index" asp-route-month="@nextMonthKey">›</a>
        </div>

        <div class="budget-card-track">
            <div class="budget-card-spacer" aria-hidden="true"></div>
            @foreach (var month in months)
            {
                <article class="budget-month-card @(month.MonthKey == Model.StartMonthKey ? "is-current" : string.Empty)">
                    <div class="budget-month-card-head">
                        <div>
                            <span class="budget-month-label">@month.MonthDate.ToString("MMM")</span>
                            <strong>@month.MonthDate.Year</strong>
                        </div>
                        <small>@month.CategoryRows.Count categories</small>
                    </div>
                    <p class="budget-month-meta">Available to budget</p>
                    <div class="budget-month-total @(month.ReadyToAssign >= 0 ? "positive" : "negative")">
                        @month.ReadyToAssign.ToString("C")
                    </div>
                    <div class="budget-month-stats">
                        <span>Budgeted <strong>@month.CategoryRows.Sum(row => row.Assigned).ToString("C")</strong></span>
                        <span>Outflows <strong>@Math.Abs(month.CategoryRows.Where(row => row.Activity < 0).Sum(row => row.Activity)).ToString("C")</strong></span>
                        <span>Available <strong>@month.CategoryRows.Sum(row => row.Available).ToString("C")</strong></span>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="card">
        <form method="post" asp-page-handler="Save" id="budget-form">
            <input type="hidden" name="startMonth" value="@Model.StartMonthKey" />
            <div class="table-wrap budget-grid-wrap">
                <table class="data-table budget-grid">
                    <thead>
                        <tr>
                            <th rowspan="2" class="category-column">
                                <div class="categories-heading">
                                    <span>Categories</span>
                                    <button type="button" class="add-category-button" id="open-add-category-modal" aria-label="Add category">+</button>
                                </div>
                            </th>
                            @for (var monthIndex = 0; monthIndex < months.Count; monthIndex++)
                            {
                                var month = months[monthIndex];
                                <th colspan="3" class="month-column-group">@month.MonthDate.ToString("MMM yyyy")</th>
                            }
                        </tr>
                        <tr>
                            @for (var monthIndex = 0; monthIndex < months.Count; monthIndex++)
                            {
                                <th class="month-subhead month-start">Budgeted</th>
                                <th class="month-subhead">Outflows</th>
                                <th class="month-subhead month-end">Balance</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model.CategoryGroups)
                        {
                            <tr class="group-row">
                                <td colspan="@(1 + months.Count * 3)">
                                    <div class="budget-group-head">
                                        <input type="text"
                                               class="group-name-input"
                                               name="GroupNames[@group.Id]"
                                               value="@group.Name"
                                               aria-label="Group name for @group.Name" />
                                        <button type="button"
                                                class="group-toggle"
                                                data-group="@group.Id"
                                                aria-expanded="true"
                                                aria-label="Collapse @group.Name">
                                            ▾
                                        </button>
                                        <span class="badge">@group.Categories.Count categories</span>
                                    </div>
                                </td>
                            </tr>

                            @foreach (var category in group.Categories)
                            {
                                <tr class="budget-group-row" data-group="@group.Id">
                                    <td class="category-column">
                                        <div class="budget-category-editor">
                                            <input type="text"
                                                   name="CategoryNames[@category.Id]"
                                                   value="@category.Name"
                                                   aria-label="Category name for @category.Name" />
                                        </div>
                                    </td>

                                    @for (var monthIndex = 0; monthIndex < months.Count; monthIndex++)
                                    {
                                        var month = months[monthIndex];
                                        var row = month.CategoryRows.FirstOrDefault(item => item.CategoryId == category.Id);
                                        if (row is null)
                                        {
                                            row = new CategoryBudgetRow(group.Id, group.Name, category.Id, category.Name, category.MonthlyTarget, 0m, 0m, 0m);
                                        }

                                        <td class="budget-value-cell month-start">
                                            <input type="number"
                                                   step="0.01"
                                                   name="BudgetedAmounts[@(month.MonthKey + "|" + category.Id)]"
                                                   value="@row.Assigned"
                                                   aria-label="@($"Budgeted amount for {category.Name} in {month.MonthDate:MMMM yyyy}")" />
                                        </td>
                                        <td class="budget-value-cell @(row.Activity >= 0 ? "positive" : "negative")">@row.Activity.ToString("C")</td>
                                        <td class="budget-value-cell month-end @(row.Available >= 0 ? "positive" : "negative")">@row.Available.ToString("C")</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="budget-savebar">
                <div>
                    <strong>Most prominent number:</strong>
                    Ready to budget in @months[0].MonthDate.ToString("MMMM yyyy") is
                    <span class="budget-savebar-amount">@months[0].ReadyToAssign.ToString("C")</span>
                </div>
                <div class="autosave-status" id="budget-autosave-status">Changes save automatically.</div>
            </div>
        </form>
    </section>

    <section class="card">
        <h3>Move money</h3>
        <p class="inline-help">Cover overspending or reprioritize without leaving the budget screen.</p>
        <form method="post" asp-page-handler="Move" class="form-grid">
            <input type="hidden" name="startMonth" value="@Model.StartMonthKey" />
            <label>
                <span>Month</span>
                <select name="monthToMove">
                    @foreach (var month in months)
                    {
                        <option value="@month.MonthKey">@month.MonthDate.ToString("MMMM yyyy")</option>
                    }
                </select>
            </label>
            <label>
                <span>From</span>
                <select name="fromCategoryId">
                    @foreach (var group in Model.CategoryGroups)
                    {
                        @foreach (var category in group.Categories)
                        {
                            <option value="@category.Id">@group.Name - @category.Name</option>
                        }
                    }
                </select>
            </label>
            <label>
                <span>To</span>
                <select name="toCategoryId">
                    @foreach (var group in Model.CategoryGroups)
                    {
                        @foreach (var category in group.Categories)
                        {
                            <option value="@category.Id">@group.Name - @category.Name</option>
                        }
                    }
                </select>
            </label>
            <label>
                <span>Amount</span>
                <input type="number" step="0.01" name="amount" value="0" />
            </label>
            <button type="submit">Move money</button>
        </form>
    </section>
</section>

<dialog class="budget-modal" id="add-category-modal">
    <form method="post" asp-page-handler="AddCategory" class="budget-modal-form">
        <input type="hidden" name="startMonth" value="@Model.StartMonthKey" />
        <div class="budget-modal-head">
            <div>
                <p class="eyebrow">Category setup</p>
                <h3>Add a category</h3>
            </div>
            <button type="button" class="modal-close" id="close-add-category-modal" aria-label="Close add category dialog">×</button>
        </div>

        <label>
            <span>Category name</span>
            <input type="text" name="categoryName" placeholder="Internet" />
        </label>

        <fieldset class="modal-choice-group">
            <legend>Group</legend>
            <label class="choice-card">
                <input type="radio" name="groupMode" value="existing" checked="@Model.CategoryGroups.Any()" />
                <span>Use an existing group</span>
            </label>
            <label class="choice-card">
                <input type="radio" name="groupMode" value="new" checked="@(!Model.CategoryGroups.Any())" />
                <span>Create a new group</span>
            </label>
        </fieldset>

        <label id="existing-group-field">
            <span>Existing group</span>
            <select name="groupId">
                @foreach (var group in Model.CategoryGroups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
        </label>

        <label id="new-group-field">
            <span>New group name</span>
            <input type="text" name="newGroupName" placeholder="Subscriptions" />
        </label>

        <div class="budget-modal-actions">
            <button type="button" class="secondary" id="cancel-add-category-modal">Cancel</button>
            <button type="submit">Create category</button>
        </div>
    </form>
</dialog>

<script>
    document.querySelectorAll('.group-toggle').forEach(function (button) {
        button.addEventListener('click', function () {
            var groupId = button.getAttribute('data-group');
            var isExpanded = button.getAttribute('aria-expanded') === 'true';
            document.querySelectorAll('.budget-group-row[data-group="' + groupId + '"]').forEach(function (row) {
                row.hidden = isExpanded;
            });
            button.setAttribute('aria-expanded', (!isExpanded).toString());
            button.textContent = isExpanded ? '▸' : '▾';
        });
    });

    var addCategoryModal = document.getElementById('add-category-modal');
    var openAddCategoryModal = document.getElementById('open-add-category-modal');
    var closeAddCategoryModal = document.getElementById('close-add-category-modal');
    var cancelAddCategoryModal = document.getElementById('cancel-add-category-modal');
    var existingGroupField = document.getElementById('existing-group-field');
    var newGroupField = document.getElementById('new-group-field');
    var budgetForm = document.getElementById('budget-form');
    var autosaveStatus = document.getElementById('budget-autosave-status');
    var autosaveTimer = null;
    var autosaveInFlight = false;
    var autosaveQueued = false;

    function syncGroupMode() {
        var selected = document.querySelector('input[name="groupMode"]:checked');
        var useNewGroup = selected && selected.value === 'new';
        existingGroupField.hidden = useNewGroup;
        newGroupField.hidden = !useNewGroup;
    }

    function setAutosaveStatus(message, state) {
        if (!autosaveStatus) {
            return;
        }

        autosaveStatus.textContent = message;
        autosaveStatus.dataset.state = state || '';
    }

    async function performAutosave() {
        if (!budgetForm) {
            return;
        }

        if (autosaveInFlight) {
            autosaveQueued = true;
            return;
        }

        autosaveInFlight = true;
        autosaveQueued = false;
        setAutosaveStatus('Saving changes...', 'saving');

        try {
            var formData = new FormData(budgetForm);
            var response = await fetch(window.location.pathname + '?handler=Save', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!response.ok) {
                throw new Error('Save failed.');
            }

            var result = await response.json();
            setAutosaveStatus('Saved at ' + result.savedAt, 'saved');
        } catch (error) {
            setAutosaveStatus('Autosave failed. Refresh and try again.', 'error');
        } finally {
            autosaveInFlight = false;
            if (autosaveQueued) {
                performAutosave();
            }
        }
    }

    function requestAutosave(immediate) {
        if (!budgetForm) {
            return;
        }

        if (autosaveTimer) {
            clearTimeout(autosaveTimer);
        }

        if (immediate) {
            performAutosave();
            return;
        }

        setAutosaveStatus('Changes not saved yet...', 'pending');
        autosaveTimer = setTimeout(function () {
            performAutosave();
        }, 900);
    }

    if (budgetForm) {
        budgetForm.addEventListener('input', function (event) {
            if (event.target.matches('input[type="text"], input[type="number"]')) {
                requestAutosave(false);
            }
        });

        budgetForm.addEventListener('change', function (event) {
            if (event.target.matches('input[type="text"], input[type="number"], select')) {
                requestAutosave(false);
            }
        });

        budgetForm.addEventListener('focusout', function (event) {
            if (event.target.matches('input[type="text"], input[type="number"], select')) {
                requestAutosave(true);
            }
        });

        budgetForm.addEventListener('submit', function (event) {
            event.preventDefault();
            requestAutosave(true);
        });
    }

    if (openAddCategoryModal && addCategoryModal) {
        openAddCategoryModal.addEventListener('click', function () {
            addCategoryModal.showModal();
            syncGroupMode();
        });
    }

    [closeAddCategoryModal, cancelAddCategoryModal].forEach(function (button) {
        if (!button || !addCategoryModal) {
            return;
        }

        button.addEventListener('click', function () {
            addCategoryModal.close();
        });
    });

    document.querySelectorAll('input[name="groupMode"]').forEach(function (radio) {
        radio.addEventListener('change', syncGroupMode);
    });

    syncGroupMode();
</script>
