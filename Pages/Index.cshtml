@page "/dashboard"
@model Spendwise.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="hero card">
    <div>
        <p class="eyebrow">Month in focus</p>
        <h2>@Model.Dashboard.Month.MonthDate.ToString("MMMM yyyy")</h2>
        <p class="lede">See how much cash is available, how much is protected for upcoming expenses, and whether your next month buffer is growing.</p>
    </div>
    <form method="get" class="inline-form compact-form">
        <label>
            <span>Month</span>
            <input type="month" name="month" value="@Model.Dashboard.Month.MonthKey" />
        </label>
        <button type="submit">View</button>
    </form>
</section>

<section class="metrics-grid">
    <article class="metric card accent-positive">
        <span>Ready to assign</span>
        <strong>@Model.Dashboard.Month.ReadyToAssign.ToString("C")</strong>
        <small>Cash not yet assigned to a category.</small>
    </article>
    <article class="metric card">
        <span>Total cash</span>
        <strong>@Model.Dashboard.Month.TotalCash.ToString("C")</strong>
        <small>Across all tracked accounts.</small>
    </article>
    <article class="metric card">
        <span>Protected for true expenses</span>
        <strong>@Model.Dashboard.ProtectedForTrueExpenses.ToString("C")</strong>
        <small>Funds sitting in target-based categories.</small>
    </article>
    <article class="metric card accent-warm">
        <span>Next month buffer</span>
        <strong>@Model.Dashboard.BufferBalance.ToString("C")</strong>
        <small>Money reserved to get ahead.</small>
    </article>
</section>

<section class="two-column">
    <article class="card">
        <h3>Principles in practice</h3>
        <div class="principles">
            <div>
                <strong>Assign current cash</strong>
                <p>Only budget money already in your accounts, so your plan stays grounded in reality.</p>
            </div>
            <div>
                <strong>Prepare for irregular bills</strong>
                <p>Set targets for categories like maintenance, holidays, and annual expenses before they surprise you.</p>
            </div>
            <div>
                <strong>Adjust without guilt</strong>
                <p>If priorities change, move money between categories instead of abandoning the whole plan.</p>
            </div>
        </div>
    </article>

    <article class="card">
        <h3>Recent transactions</h3>
        <div class="list-stack">
            @foreach (var transaction in Model.Dashboard.RecentTransactions)
            {
                <div class="list-row">
                    <div>
                        <strong>@transaction.Payee</strong>
                        <p>@transaction.CategoryName · @transaction.AccountName</p>
                    </div>
                    <div class="amount-block">
                        <strong class="@(transaction.Amount >= 0 ? "positive" : "negative")">@transaction.Amount.ToString("C")</strong>
                        <small>@transaction.Date.ToString("dd MMM")</small>
                    </div>
                </div>
            }
        </div>
    </article>
</section>
